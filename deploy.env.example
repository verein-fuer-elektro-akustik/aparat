# Copy to deploy.env (git-ignored) and adjust. Read by deploy.sh.

# ssh host to deploy to
DEPLOY_HOST=vvv

# static frontend, served by nginx at PUBLIC_URL
WEB_DIR=/home/tong/web/aparat

# the API service: server.js, factory presets, nginx include, .env
APP_DIR=/home/tong/app/aparat

# stored presets, kept across deploys
PRESETS_DIR=/home/tong/app/aparat/data/presets

# where the API listens; nginx proxies /aparat/api/ here
API_HOST=127.0.0.1
API_PORT=8001

# checked after deploying
PUBLIC_URL=https://velak.klingt.org/aparat/
